<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <form action="/listing" method="post">
        <input type="text" name="listing[title]" placeholder="title">
        <br><br><br>
        <input type="text" name="listing[image]" placeholder="enter image url/link">
        <br><br><br>
        <textarea name="listing[description]" placeholder="enter description"></textarea>
        <br><br><br>
        <input type="number" name="listing[price]" placeholder="price">
        <br><br><br>
        <input type="text" name="listing[location]" placeholder="location">
        <br><br><br>
        <input type="text" name="listing[country]" placeholder="country">
        <br><br><br>

        <button>submit</button>
    </form>
</body>
</html>