<% layout("/layouts/boilerplate.ejs")%>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h3>show list</h3>
            </div>
            <div class="card col-6 offset-3">
                <img src="<%=Listing.image.url%>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <p class="card-text">
                        <b>
                            <%=Listing.title%>
                        </b><br>
                        <%=Listing.description%><br>
                            &#8377 <%=Listing.price!=null?Listing.price.toLocaleString("en-IN"):"N/A"%>/Night</li> <br>
                                <%=Listing.location%> <br>
                                    <%=Listing.country%> <br>
                                        <%=Listing._id%> <br>
                                        <br>
                                            <div class="btns">
                                                <a href="/listing/<%=Listing._id%>/edit" class="btn btn-dark col-2 offset-0">Edit</a>

                                                <form action="/listing/<%=Listing._id%>?_method=Delete" method="post">
                                                    <button class="btn btn-danger offset-2 ">Delete</button>
                                                </form>
                                            </div>
                    </p>
                </div>
            </div>
        </div>
    </body>